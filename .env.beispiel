# Kopieren nach .env und ausfüllen. .env gehört nicht ins Repository.
DB_KENNWORT=
# Benachrichtigung per Mail an Meldende (optional):
# TICKETR_SMTP=smtp.gmail.com:587
# TICKETR_SMTP_NUTZER=
# TICKETR_SMTP_KENNWORT=
# TICKETR_ABSENDER=support@example.org
# TICKETR_ADRESSE=https://10.0.2.7:8350
# Notausgang, falls man sich ausgesperrt hat:
# TICKETR_SSO_AUS=1
# Wer verwaltet, zusätzlich zum ersten Konto aus der Einrichtung. Bei SSO nötig:
# TICKETR_ADMIN=oidc:https://anbieter.example/realms/name|<sub>
